# Скопируйте в .env и поменяйте значения:  cp .env.example .env

# Пароль базы данных (любая длинная строка)
POSTGRES_PASSWORD=change-me-db-password

# Пароль для входа в приложение. Пусто = вход без пароля (только для локальной сети!)
APP_PASSWORD=change-me-login-password

# Секрет для подписи сессий, 32+ символа. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Порт, на котором будет открыт сайт: http://localhost:8080
HTTP_PORT=8080

# true, если сайт открывается по HTTPS (за Caddy / Traefik / Cloudflare Tunnel)
COOKIE_SECURE=false
