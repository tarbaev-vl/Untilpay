# Copy to .env and change the values:  cp .env.example .env

# Database password (any long string)
POSTGRES_PASSWORD=change-me-db-password

# Password for signing in to the app. Empty = no password (local network only!)
APP_PASSWORD=change-me-login-password

# Secret for signing sessions, 32+ characters. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Port the site is served on: http://localhost:8080
HTTP_PORT=8080

# true forces the Secure flag on the session cookie. Requests through the Cloudflare Tunnel get it automatically;
# set true only if the site is opened over HTTPS some other way (Caddy / Traefik)
COOKIE_SECURE=false

# Cloudflare Tunnel: access from the internet without opening ports (see README → Access from outside).
# Set APP_PASSWORD first! Uncomment the profile and paste the tunnel token from the Cloudflare dashboard.
# COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# "Budget advice": which LLM gives the advice. Empty — the advice panel shows setup instructions.
# anthropic | openai | gemini | mistral | deepseek | openrouter | groq | xai | ollama
LLM_PROVIDER=anthropic
# API key of the chosen provider (not needed for ollama)
LLM_KEY=
# Optional: your own model instead of the provider's default (claude-opus-5-5, gpt-5, gemini-2.5-pro…)
LLM_MODEL=
# Optional: your own API address (a proxy, Ollama on another machine)
LLM_BASE_URL=

# Bank sync through Enable Banking (optional, CSV import works without it). See README → Bank sync.
# Application ID from the Enable Banking control panel. Empty — bank sync is off.
EB_APP_ID=
# Private key of that application inside the container; put the .pem file into ./secrets/
EB_PRIVATE_KEY_FILE=/run/secrets/enablebanking.pem
# Where the bank sends the browser back; must be listed among the application's redirect URLs.
# With the tunnel use the public address: https://untilpay.example.com/api/bank/callback
EB_REDIRECT_URL=http://localhost:8080/api/bank/callback
