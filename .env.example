# Copy to .env and change the values:  cp .env.example .env

# Database password (any long string)
POSTGRES_PASSWORD=change-me-db-password

# Password for signing in to the app. Empty = no password (local network only!)
APP_PASSWORD=change-me-login-password

# Secret for signing sessions, 32+ characters. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Port the site is served on: http://localhost:8080
HTTP_PORT=8080

# true if the site is opened over HTTPS (behind Caddy / Traefik / Cloudflare Tunnel)
COOKIE_SECURE=false

# "Budget advice": which LLM gives the advice. Empty — the advice panel shows setup instructions.
# anthropic | openai | gemini | mistral | deepseek | openrouter | groq | xai | ollama
LLM_PROVIDER=anthropic
# API key of the chosen provider (not needed for ollama)
LLM_KEY=
# Optional: your own model instead of the provider's default (claude-opus-5-5, gpt-5, gemini-2.5-pro…)
LLM_MODEL=
# Optional: your own API address (a proxy, Ollama on another machine)
LLM_BASE_URL=
